nation": "$27-12=15$ अर्थात् O।"}, {"q": "यदि RED = 27, तो GREEN = ?", "options": ["49", "52", "50", "45"], "answer": 0, "explanation": "$R=18,E=5,D=4$; $18+5+4=27$; GREEN: $7+18+5+5+14=49$।"}, {"q": "A=1 से Z=26 मानें तो 'ZERO' का योग?", "options": ["72", "70", "64", "76"], "answer": 2, "explanation": "$26+5+18+15=64$।"}, {"q": "अंग्रेज़ी वर्णमाला में 10वाँ अक्षर?", "options": ["I", "H", "K", "J"], "answer": 3, "explanation": "EJOTY में J=10।"}, {"q": "अंग्रेज़ी वर्णमाला में अंत से 5वाँ अक्षर?", "options": ["V", "W", "T", "U"], "answer": 0, "explanation": "Z, Y, X, W, V — पाँचवाँ V।"}], "images_base": "https://raw.githubusercontent.com/aloklmp99/khaki/main/his/rea-coding/", "images": ["al", "al2", "ty", "st"]}